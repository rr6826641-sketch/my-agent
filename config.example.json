{
  "base_url": "https://api.groq.com/openai/v1",
  "model": "llama-3.3-70b-versatile",
  "mock_mode": false,
  "red_team_mode": false,
  "refusal_retries": 3,
  "fallback_models": [
    "openai/gpt-oss-20b",
    "qwen/qwen3.8-27b",
    "allam-2-7b"
  ],
  "max_iterations": 60,
  "parallel_max_workers": 4,
  "mcp_servers": [
    {
      "name": "local-fs-demo",
      "command": "python",
      "args": [
        "mcp_servers/local_fs_demo.py"
      ],
      "prefix": "mcp_",
      "confirm": false
    }
  ],
  "local_first": false,
  "local_endpoints": [
    {
      "name": "openrouter",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "models": [
        "nvidia/nemotron-3-super-120b-a12b:free",
        "nvidia/nemotron-3-ultra-550b-a55b:free"
      ],
      "timeout": 20.0
    }
  ],
  "auto": false
}