{
  "base_url": "https://api.groq.com/openai/v1",
  "model": "qwen/qwen3.8-27b",
  "mock_mode": false,
  "red_team_mode": false,
  "refusal_retries": 8,
  "fallback_models": [
    "notrack-uncensored",
    "openai/gpt-oss-20b",
    "qwen/qwen3.8-27b",
    "allam-2-7b",
    "Qwen/Qwen3.8-27B",
    "deepseek-ai/DeepSeek-V4-Flash"
  ],
  "max_iterations": 120,
  "parallel_max_workers": 4,
  "mcp_servers": [
    {
      "name": "local-fs-demo",
      "command": "python",
      "args": [
        "mcp_servers/local_fs_demo.py"
      ],
      "prefix": "mcp_",
      "confirm": false
    }
  ],
  "local_first": false,
  "local_endpoints": [
    {
      "name": "notrack",
      "base_url": "https://api.notrack.ai/v1",
      "api_key_env": "NOTRACK_API_KEY",
      "models": [
        "notrack-uncensored"
      ],
      "timeout": 30.0
    },
    {
      "name": "openrouter",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "models": [
        "mistralai/mixtral-8x22b-instruct",
        "sao10k/l3.3-euryale-70b",
        "cognitivecomputations/dolphin-mistral-24b-venice-edition",
        "nousresearch/hermes-4-70b",
        "nousresearch/hermes-3-llama-3.1-70b",
        "gryphe/mythomax-l2-13b",
        "sao10k/l3.1-euryale-70b",
        "nousresearch/hermes-4-405b",
        "qwen/qwen3-coder",
        "nvidia/nemotron-3-super-120b-a12b:free",
        "nvidia/nemotron-3-ultra-550b-a55b:free"
      ],
      "timeout": 20.0
    },
    {
      "name": "venice",
      "base_url": "https://api.venice.ai/api/v1",
      "api_key_env": "VENICE_API_KEY",
      "models": [
        "venice-uncensored-1-2",
        "venice-uncensored-role-play"
      ],
      "timeout": 30.0
    },
    {
      "name": "huggingface",
      "base_url": "https://router.huggingface.co/v1",
      "api_key_env": "HUGGINGFACE_API_KEY",
      "models": [
        "Qwen/Qwen3.8-27B",
        "openai/gpt-oss-20b",
        "deepseek-ai/DeepSeek-V4-Flash"
      ],
      "timeout": 30.0
    }
  ],
  "auto": false,
  "persona": "ultra",
  "red_team_level": "ultra",
  "pin_uncensored": true,
  "pin_strict": true,
  "_notes": {
    "model": "qwen/qwen3.8-27b is the only Groq model ID that returns 200 (llama-3.3-70b-versatile is dead/404).",
    "pin_uncensored": "PIN + pin_strict are complementary, NOT contradictory: pin_uncensored=True drops the primary and pins the chain to the uncensored pool only; pin_strict=True keeps generic (safety-tuned) cloud fallbacks out. Together the chain is 100% uncensored tier - no censorship filter is added.",
    "huggingface_models": "Router-supported IDs only (router.huggingface.co/v1/models). abliterated/dolphin old IDs are delisted (HTTP 400).",
    "openrouter": "Free variants work with 0 balance; credit model IDs return HTTP 402."
  }
}
