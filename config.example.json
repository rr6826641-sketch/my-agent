{
  "base_url": "https://api.groq.com/openai/v1",
  "model": "llama-3.3-70b-versatile",
  "mock_mode": false,
  "red_team_mode": false,
  "refusal_retries": 3,
  "fallback_models": [
    "openai/gpt-oss-20b",
    "qwen/qwen3.8-27b",
    "allam-2-7b"
  ],
  "max_iterations": 60,
  "parallel_max_workers": 4,
