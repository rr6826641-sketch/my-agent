# Copy this file to .env and fill in your values
# (OpenAI, OpenRouter, Groq, Together, Ollama, LM Studio - any OpenAI-compatible API)
AGENT_API_KEY=sk-your-primary-key-here   # e.g. Groq gsk_...
# Optional: secondary routed host key (OpenRouter plug-in in local_endpoints).
OPENROUTER_API_KEY=sk-or-v2-...
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini

# Optional: where memory is stored
# AGENT_MEMORY_FILE=memory.json

# Optional: auto-connect MCP servers on agent start (JSON list of specs).
# Each spec: {"command": "...", "args": [...], "env": {...}, "prefix": "mcp_", "confirm": false}
# MCP_SERVERS=[{"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]}]

# Optional: secondary endpoint plug-in provider (e.g. Groq).
# Add the matching local_endpoints block in config.json (api_key_env: GROQ_API_KEY).
GROQ_API_KEY=gsk-your-groq-key

# Venice.ai plug-in (private uncensored API). Add the matching
# local_endpoints block in config.json (api_key_env: VENICE_API_KEY).
VENICE_API_KEY=vn-your-venice-key

# HuggingFace Inference Providers (router.huggingface.co). Serves the
# huihui-ai Llama-3.3-70B abliterated + dolphin-2.9.2-qwen2-72b builds
# that are not on OpenRouter (api_key_env: HUGGINGFACE_API_KEY).
# Needs an HF token with inference rights (free/PRO/pay-as-you-go).
HUGGINGFACE_API_KEY=hf_your_hf_token
