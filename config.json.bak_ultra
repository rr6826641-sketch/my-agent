{
  "base_url": "https://api.groq.com/openai/v1",
  "model": "qwen/qwen3.8-27b",
  "mock_mode": false,
  "max_iterations": 120,
  "max_messages": 400,
  "spawn_timeout": 900,
  "max_spawn_depth": 3,
  "allow_subagents": true,
